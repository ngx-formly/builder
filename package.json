{
  "name": "formly-editor",
  "version": "0.0.0",
  "author": "Samuel Esan (https://github.com/sesan07)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ngx-formly/builder.git"
  },
  "homepage": "https://formlystudio.com/",
  "workspaces": [
    "apps/docs",
    "libs/state",
    "libs/core",
    "libs/ui/material",
    "libs/ui/builder-material"
  ],
  "scripts": {
    "prepare": "husky",
    "ng": "ng",
    "start": "ng serve studio --host 0.0.0.0",
    "start:docs": "npm run dev --workspace @ngx-formly/builder-docs",
    "build": "npm run build:builder-material && npm run check:packages && npm run build:studio && npm run build:docs",
    "build:studio": "ng build studio",
    "build:state": "ng build state",
    "prebuild:core": "npm run build:state",
    "build:core": "ng build core",
    "build:material": "ng build material",
    "prebuild:builder-material": "npm run build:core && npm run build:material",
    "build:builder-material": "ng build builder-material",
    "build:docs": "npm run build --workspace @ngx-formly/builder-docs",
    "check:docs": "npm run check --workspace @ngx-formly/builder-docs",
    "check:packages": "node scripts/check-package-contracts.mjs && node scripts/check-packed-consumer.mjs",
    "check:packages:e2e": "node scripts/check-packed-consumer.mjs --browser",
    "preview:docs": "npm run preview --workspace @ngx-formly/builder-docs",
    "test:e2e": "playwright test --config apps/studio/playwright.config.ts",
    "test": "npm run test:studio && npm run test:state && npm run test:core && npm run test:material && npm run test:builder-material",
    "test:studio": "ng test studio --watch=false",
    "test:state": "ng test state --watch=false",
    "test:core": "ng test core --watch=false",
    "test:material": "ng test material --watch=false",
    "test:builder-material": "ng test builder-material --watch=false",
    "lint": "ng lint studio && ng lint state && ng lint core && ng lint material && ng lint builder-material"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/material": "^22.2.4",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@dragdroptouch/drag-drop-touch": "^2.0.3",
    "@ngx-formly/bootstrap": "^11.0.0",
    "@ngx-formly/core": "^11.0.0",
    "@ngx-formly/material": "^11.0.0",
    "@ngx-formly/ng-zorro-antd": "^11.0.0",
    "@primeuix/themes": "^2.0.3",
    "@uiw/codemirror-theme-vscode": "^4.25.11",
    "bootstrap": "^5.3.8",
    "codemirror": "^6.0.2",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.15",
    "file-saver": "^2.0.5",
    "js-beautify": "^1.15.4",
    "lodash-es": "^4.17.21",
    "marked": "^18.0.13",
    "mutative": "^1.3.0",
    "ng-zorro-antd": "^22.1.2",
    "ngx-drag-drop": "^22.1.0",
    "primeng": "^21.1.10",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.1.17",
    "tailwindcss-primeui": "^0.6.1",
    "terser": "^5.51.2",
    "tslib": "^2.3.0",
    "uuid": "^13.0.0",
    "zod": "^4.6.7",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@eslint/js": "^9.8.0",
    "@playwright/test": "^1.36.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/file-saver": "^2.0.7",
    "@types/js-beautify": "^1.14.3",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "4.1.9",
    "angular-eslint": "22.6.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-playwright": "^1.6.2",
    "husky": "^9.1.7",
    "jsdom": "~28.0.0",
    "less": "^4.9.1",
    "ng-packagr": "^22.2.4",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.40.0",
    "vitest": "4.1.9"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "overrides": {
    "primeng": {
      "@angular/cdk": "$@angular/cdk",
      "@angular/common": "$@angular/common",
      "@angular/core": "$@angular/core",
      "@angular/forms": "$@angular/forms",
      "@angular/platform-browser": "$@angular/platform-browser",
      "@angular/router": "$@angular/router"
    }
  }
}
